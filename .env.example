NODE_ENV=development
PORT=4050
# directConnection=true is what makes a single-node replica set reachable from
# the host: the member advertises `mongo:27017` (its compose service name), which
# only resolves inside the Docker network. Without it the driver answers
# "getaddrinfo ENOTFOUND mongo". Transactions need the replica set; this flag
# needs nothing else.
MONGODB_URI=mongodb://127.0.0.1:27018/ecom_cms?directConnection=true
JWT_SECRET=replace-with-at-least-32-characters
REDIS_URL=redis://localhost:6379
# Absolute path for uploaded media. Optional in development (defaults to
# <cwd>/storage); required in production. The service refuses to boot when the
# directory is relative or not writable.
STORAGE_LOCAL_DIR=
